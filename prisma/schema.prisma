generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Unidade {
  id       Int      @id @default(autoincrement())
  nome     String
  corHex   String
  criadoEm DateTime @default(now())
}

model Caminhao {
  id                   Int            @id @default(autoincrement())
  placa                String
  caixaId              Int?
  criadoEm             DateTime       @default(now())
  status               StatusCaminhao
  tipo                 TipoResiduo?
  destinoCaixaId       Int?
  motorista            String
  transportadora       String
  horaColeta           DateTime?
  horaSaida            DateTime?
  tempoLiberacaoMin    Int?

  // 📌 Novos campos adicionados:
  documentoMotorista   String
  possuiMTR            Boolean        @default(false)
  possuiNotaFiscal     Boolean        @default(false)
  anomaliaVeiculo      Boolean        @default(false)
  descricaoAnomalia    String?
  possuiEPI            Boolean        @default(false)
  vestimentaIrregular  Boolean        @default(false)
  estadoFisico         String?        // "normal", "embriagado", "alterado", etc.

  analises             Analise[]
  caixa                Caixa?         @relation("CaixaAtual", fields: [caixaId], references: [id])
  destinoCaixa         Caixa?         @relation("CaixaDestino", fields: [destinoCaixaId], references: [id])

  @@index([caixaId], map: "Caminhao_caixaId_fkey")
  @@index([destinoCaixaId], map: "Caminhao_destinoCaixaId_fkey")
}

model Analise {
  id                      Int            @id @default(autoincrement())
  caminhaoId              Int
  status                  StatusCaminhao
  tanque                  String
  observacoes             String
  criadoEm                DateTime       @default(now())
  liberadaIncompativel    Boolean?       @default(false) // ✅ Novo campo para controle químico
  caminhao                Caminhao       @relation(fields: [caminhaoId], references: [id])

  @@index([caminhaoId], map: "Analise_caminhaoId_fkey")
}

model Caixa {
  id          Int         @id @default(autoincrement())
  nome        String      @unique
  status      StatusCaixa
  tipoResiduo TipoResiduo
  linhaId     Int?
  criadoEm    DateTime    @default(now())
  linha       Linha?      @relation(fields: [linhaId], references: [id])
  caminhoes   Caminhao[]  @relation("CaixaAtual")
  destinoPara Caminhao[]  @relation("CaixaDestino")

  @@index([linhaId], map: "Caixa_linhaId_fkey")
}

model Linha {
  id               Int         @id @default(autoincrement())
  nome             String      @unique
  tipo             TipoResiduo
  status           StatusLinha
  motivoManutencao String?
  tempoMedio       Int
  eficiencia       Int
  cargaAtual       Int
  ultimaManutencao DateTime
  criadoEm         DateTime    @default(now())
  caixas           Caixa[]
}

model Usuario {
  id         Int         @id @default(autoincrement())
  username   String      @unique
  senhaHash  String
  email      String?
  documento  String?
  role       Role        @default(PADRAO)
  criadoEm   DateTime    @default(now())
  permissoes Permissao[]
}

model Permissao {
  id        Int     @id @default(autoincrement())
  usuarioId Int
  modulo    Modulo
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId], map: "Permissao_usuarioId_fkey")
}

model LogUsuario {
  id         Int      @id @default(autoincrement())
  usuarioId  Int?
  acao       String
  autor      String
  modulo     String?
  detalhes   String?
  criadoEm   DateTime @default(now())
}

enum StatusLinha {
  active
  maintenance
}

enum StatusCaixa {
  livre
  ocupada
}

enum StatusCaminhao {
  waiting
  in_progress
  approved
  incompatible
  rejected
  finalizado
}

enum TipoResiduo {
  Diversos
  Oleoso
  Alcalino
  Acidos
  Lodo
}

enum Role {
  SYSADMIN
  PADRAO
  QUIMICO
}

enum Modulo {
  DASHBOARD
  LABORATORIO
  HISTORICO
  ESTACIONAMENTO
  LINHAS
  CAIXAS
  CAMINHAO
}